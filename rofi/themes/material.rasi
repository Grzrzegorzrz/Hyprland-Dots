/*
 * ROFI color theme
 *
 * Modified slightly from this: https://github.com/Murzchnvok/rofi-collection
 *
 * User: Contributors
 * Copyright: *!
 */

configuration {
  font: "JetBrainsMono Nerd Font Medium 12";

  drun {
    display-name: "";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  recursivebrowser {
    display-name: "/";
  }
}

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;

  bg: #151515;
  bg-alt: #232323;
  bg-selected: #383331;
  fg: #FFFFFF;
  fg-alt: #878787;

  background-color: @bg;
  text-color: @fg;
}

window {
  transparency: "rrealeal";
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  background-color: @bg-alt;
  children: [prompt, entry];
}

entry {
  background-color: inherit;
  padding: 12px 3px;
}

prompt {
  background-color: inherit;
  padding: 12px 18px;
}

listview {
  lines: 8;
}

element {
  children: [element-icon, element-text];
}

element-icon {
  size: 2ch;
  padding: 10px 10px;
}

element-icon selected {
  background-color: @bg-selected;
}

element-text {
  padding: 10px 0;
  text-color: @fg-alt;
}

element-text selected {
  text-color: @fg;
  background-color: @bg-selected;
}
